DATABASE_URL=postgresql+psycopg2://navi:navi@localhost:5432/navi
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
VOYAGE_API_KEY=

JWT_SECRET=change-me-in-production
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated, newest first, for key rotation. Losing this makes encrypted PHI unrecoverable — back it up.
FIELD_ENCRYPTION_KEYS=

COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

CORS_ORIGINS=["http://localhost:3000"]
DOCUMENT_STORAGE_PATH=./storage/documents
MAX_UPLOAD_SIZE_MB=15

# "mock" (default — safe for demos, no contract needed) or "availity" (requires real
# clearinghouse credentials — see app/integrations/eligibility.py)
ELIGIBILITY_PROVIDER=mock
AVAILITY_API_KEY=
AVAILITY_API_BASE_URL=https://api.availity.com

ENVIRONMENT=development
